---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contacto | A.P ASOCIADOS C.A" activePage="contact">
  <section class="contact-hero">
    <div class="contact-hero__inner"><span class="section-kicker">Contacto</span><h1 class="contact-hero__title">Contáctanos</h1><div class="header-line"></div><p class="contact-lead">Comparte tus requerimientos y nuestro equipo se pondrá en contacto para coordinar la mejor solución.</p></div>
  </section>
  <section class="contact-content">
    <div class="contact-grid">
      <div class="contact-card"><div class="contact-card__icon">⌖</div><h3>Ubicación</h3><p>Puerto Ordaz, Estado Bolívar<br />Venezuela</p></div>
      <div class="contact-card"><div class="contact-card__icon">◷</div><h3>Horario</h3><p>Lunes a Viernes<br />8:00 AM - 5:00 PM</p></div>
      <div class="contact-card"><div class="contact-card__icon">✉</div><h3>Correo</h3><p><a href="mailto:salatecnica@apasociados.com" class="contact-card__link">salatecnica@apasociados.com</a><br /><a href="mailto:jhpostiglione@apasociados.com" class="contact-card__link">jhpostiglione@apasociados.com</a><br /><a href="mailto:gtegeneral@apasociados.com" class="contact-card__link">gtegeneral@apasociados.com</a></p></div>
    </div>
    <div class="contact-services"><h3>¿Qué podemos hacer por ti?</h3><div class="contact-services__grid"><div class="contact-services__item"><span class="contact-services__accent"></span><span>Diseño y fabricación de estructuras</span></div><div class="contact-services__item"><span class="contact-services__accent"></span><span>Mantenimiento industrial y reparaciones</span></div><div class="contact-services__item"><span class="contact-services__accent"></span><span>Representaciones y suministros</span></div><div class="contact-services__item"><span class="contact-services__accent"></span><span>Soporte técnico y asesoría</span></div></div></div>
    <form class="contact-form" id="contactForm"><h3>Envíanos un mensaje</h3><p class="contact-form__subtitle">Completa el formulario y te responderemos a la brevedad.</p><div class="form-row"><div class="form-group"><label for="nombre">Nombre y apellido</label><input type="text" id="nombre" name="from_name" placeholder="Tu nombre" required /></div><div class="form-group"><label for="correo">Correo electrónico</label><input type="email" id="correo" name="from_email" placeholder="tu@correo.com" required /></div></div><div class="form-group"><label for="mensaje">Mensaje</label><textarea id="mensaje" name="message" rows="6" placeholder="Cuéntanos sobre tu necesidad" required></textarea></div><button type="submit" class="cta-button" id="submitBtn">Enviar mensaje</button><p class="form-note" id="formNote">Tu mensaje será enviado directamente a nuestro equipo.</p></form>
  </section>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
  <script is:inline>
    emailjs.init('-DQNgPdDH-K22v2O7');
    document.getElementById('contactForm').addEventListener('submit', function (event) {
      event.preventDefault();
      const button = document.getElementById('submitBtn');
      const note = document.getElementById('formNote');
      button.disabled = true;
      button.textContent = 'Enviando...';
      note.textContent = '';
      emailjs.sendForm('service_nvthdlk', 'template_m44drxx', this).then(() => {
        note.textContent = 'Mensaje enviado correctamente. Te responderemos a la brevedad.';
        note.classList.add('form-note--success');
        this.reset();
        button.textContent = 'Enviar mensaje';
        button.disabled = false;
      }).catch(() => {
        note.textContent = 'Ocurrió un error al enviar. Por favor intenta de nuevo.';
        note.style.color = '#B11212';
        button.textContent = 'Enviar mensaje';
        button.disabled = false;
      });
    });
  </script>
</BaseLayout>