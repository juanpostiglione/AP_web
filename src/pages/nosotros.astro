---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const storyPanels = [
  {
    image: 'ap_new_02.jpeg',
    alt: 'Instalaciones A.P ASOCIADOS C.A',
    kicker: 'Trayectoria',
    title: 'Calidad y productividad desde 1982',
    text: 'Con una trayectoria de calidad y productividad desde el año 1982, fecha de su puesta en marcha; cuenta con el apoyo de su personal obrero, técnico y profesional especializado.'
  },
  {
    image: 'ap_new_03.jpeg',
    alt: 'Producción metalmecánica',
    kicker: 'Calidad',
    title: 'Procesos certificados ISO 9001',
    text: 'Los procedimientos aplicados a procesos de fabricación, montaje, selección y manejo de materiales, normas de seguridad y cuidado ambiental se rigen bajo los parámetros de calidad ISO 9001.'
  }
];
---

<BaseLayout title="Nosotros | A.P ASOCIADOS C.A" activePage="about">
  <section class="nosotros-hero">
    <div class="nosotros-hero__bg"><img src={`${base}images/ap_new_01.jpeg`} alt="A.P ASOCIADOS C.A" class="nosotros-hero__img" /></div>
    <div class="nosotros-hero__content">
      <span class="nosotros-hero__kicker">Desde 1982</span>
      <h1 class="nosotros-hero__title">Capacidad y Trayectoria</h1>
      <p class="nosotros-hero__subtitle">Más de 40 años construyendo eficiencia y seguridad en la industria venezolana</p>
    </div>
  </section>

  <section class="story story--page">
    <div class="story-panels">
      {storyPanels.map((panel) => (
        <article class="story-panel">
          <div class="story-panel-media"><img src={`${base}images/${panel.image}`} alt={panel.alt} /></div>
          <div class="story-panel-content"><span class="step-kicker">{panel.kicker}</span><h3>{panel.title}</h3><p>{panel.text}</p></div>
        </article>
      ))}
      <article class="story-panel">
        <div class="story-panel-media"><img src={`${base}images/ap_new_04.jpeg`} alt="Capacidad de proyectos" /></div>
        <div class="story-panel-content">
          <span class="step-kicker">Infraestructura</span><h3>Área total y capacidad instalada</h3>
          <ul class="story-area-list"><li><span>Superficie Total:</span> 28.500 m2</li><li><span>Talleres:</span> 5.500 m2</li><li><span>Almacenes:</span> 1.300 m2</li><li><span>Oficinas:</span> 265 m2</li></ul>
        </div>
      </article>
      <article class="story-panel">
        <div class="story-panel-media"><img src={`${base}images/ap_new_05.jpeg`} alt="Equipo humano especializado" /></div>
        <div class="story-panel-content">
          <span class="step-kicker">Especialidades</span><h3>Construcciones metalmecánicas</h3><p>Empresa especializada en construcciones metalmecánicas con una larga trayectoria en fabricación y montaje de:</p>
          <ul class="story-list"><li>Estructuras metálicas</li><li>Recipientes a presión</li><li>Tuberías de alta y baja presión</li><li>Ductería</li><li>Paneles refrigerados</li><li>Múltiples petroleros</li><li>Tanques de almacenamiento</li><li>Puentes viaductos de acero</li><li>Edificaciones - Plantas industriales</li><li>Mecanizado de piezas mecánicas</li><li>Mantenimiento de plantas industriales</li><li>Reparación de conjuntos mecánicos</li></ul>
        </div>
      </article>
    </div>
  </section>

  <section class="nosotros-gallery">
    <div class="nosotros-gallery__inner"><h2 class="nosotros-gallery__title">Nuestros Proyectos</h2>
      <div class="nosotros-gallery__grid">
        <img src={`${base}images/ap_new_06.jpeg`} alt="Instalaciones A.P ASOCIADOS C.A" /><img src={`${base}images/ap_new_07.jpeg`} alt="Planta industrial A.P ASOCIADOS C.A" /><img src={`${base}images/ap_new_08.jpeg`} alt="Operaciones A.P ASOCIADOS C.A" /><img src={`${base}images/ap_005.jpg`} alt="Instalaciones A.P ASOCIADOS C.A" /><img src={`${base}images/ap_038.jpg`} alt="Equipo A.P ASOCIADOS C.A" /><img src={`${base}images/ap_048.jpg`} alt="Personal especializado" />
      </div>
    </div>
  </section>
</BaseLayout>