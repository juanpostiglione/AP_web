---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="A.P ASOCIADOS C.A - Soluciones Industriales" bodyClass="home-page site-shell" activePage="home">
  <section id="home" class="hero tw-flow-section">
    <div class="hero-bg">
      <img
        src="/images/ap_new_01.jpeg"
        alt="Instalaciones industriales de A.P Asociados"
        class="hero-bg-image active"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="hero-slogan-center gsap-hero-block">
      <span class="hero-company-name gsap-hero-line">A.P Asociados C.A</span>
      <h1 class="hero-main-slogan gsap-hero-line">Construimos <span class="slogan-key">eficiencia</span><br />y seguridad</h1>
      <span class="hero-accent-line gsap-hero-line"></span>
      <span class="hero-sub-slogan gsap-hero-line">Metalmecanica industrial desde 1982</span>
    </div>
    <div class="hero-scroll-indicator"><a href="/nosotros" class="hero-cta-link">Conocenos</a></div>
  </section>

  <section id="services" class="services tw-flow-section">
    <div class="section-header section-reveal">
      <span class="section-kicker">Nuestros Aliados</span>
      <h2>Representaciones</h2>
      <div class="header-line"></div>
    </div>
    <div class="services-grid">
      <a class="service-card representation-card tw-metal-card gsap-service-card" href="/chesterton.html">
        <div class="service-card__logo-wrap"><img src="/images/chesterton.png" alt="Chesterton" class="representation-logo" /></div>
        <div class="service-card__content"><h3>Chesterton</h3><p>Sellos mecanicos, empaquetaduras, juntas y soluciones de sellado industrial de clase mundial.</p><span class="service-card__cta">Explorar productos <span>→</span></span></div>
      </a>
      <a class="service-card representation-card tw-metal-card gsap-service-card" href="/orange-technologies.html">
        <div class="service-card__logo-wrap"><img src="/images/orange-technologies.png" alt="Orange Technologies" class="representation-logo" /></div>
        <div class="service-card__content"><h3>Orange Technologies</h3><p>Soluciones avanzadas en abrazaderas de tuberia, recubrimientos y reparacion industrial.</p><span class="service-card__cta">Explorar productos <span>→</span></span></div>
      </a>
      <a class="service-card representation-card tw-metal-card gsap-service-card" href="/worldfluid.html">
        <div class="service-card__logo-wrap"><img src="/images/worldfluid.png" alt="WorldFluid" class="representation-logo" /></div>
        <div class="service-card__content"><h3>WorldFluid</h3><p>Valvulas, tuberias, sistemas de filtracion y equipos especializados para la industria.</p><span class="service-card__cta">Explorar productos <span>→</span></span></div>
      </a>
    </div>
  </section>

  <section class="stats tw-flow-section">
    <div class="stats__inner">
      <div class="stats__header section-reveal"><span class="stats__kicker">Nuestra Trayectoria</span><h2 class="stats__title">Numeros que Respaldan</h2></div>
      <div class="stats__grid stagger-children">
        <div class="stat gsap-stat-card"><span class="stat__number" data-target="43">43+</span><span class="stat__label">Anos de Experiencia</span><span class="stat__bar"></span></div>
        <div class="stat gsap-stat-card"><span class="stat__number" data-target="50">50+</span><span class="stat__label">Miembros del Equipo</span><span class="stat__bar"></span></div>
        <div class="stat gsap-stat-card"><span class="stat__number" data-target="98">98%</span><span class="stat__label">Satisfaccion del Cliente</span><span class="stat__bar"></span></div>
      </div>
    </div>
  </section>
</BaseLayout>